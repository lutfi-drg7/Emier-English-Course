rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /news/{doc} {
      allow read: if true;
      allow write: if request.auth != null; 
    }

    match /registration/{doc} {
      allow create: if true;  
      allow read: if true;    
      allow update: if false;
      allow delete: if request.auth != null; 
    }

    match /schedule/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }


  }
}